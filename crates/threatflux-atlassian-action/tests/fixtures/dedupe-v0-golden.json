{
  "note": [
    "Golden vector for the dedupe label the Action emits today, produced by",
    "compute_dedupe_label in crates/threatflux-atlassian-action/src/rules.rs.",
    "Live Jira issues carry these exact labels, so a diff here is a",
    "compatibility break rather than a refactor: every label already written",
    "into Jira stops matching. Change this file only in the change that",
    "deliberately moves the scheme, and ship the migration with it."
  ],
  "scheme": {
    "id": "v0-sha256-12",
    "digest": "sha256",
    "hex_digest_prefix_chars": 12,
    "field_joiner": "\n",
    "label_format": "{label_prefix}-{hex_sha256_of_joined_values:.12}",
    "default_label_prefix": "jira-automation",
    "project_key": "KAN"
  },
  "cases": [
    {
      "name": "shipped-dependabot-repository-and-title",
      "event": {
        "fixture": "issues-opened-dependabot"
      },
      "label_prefix": "dependabot-alert",
      "fields": [
        "repository.full_name",
        "issue.title"
      ],
      "values": [
        "ThreatFlux/demo",
        "Bump openssl from 1.0 to 1.1"
      ],
      "label": "dependabot-alert-e6bebe4d0a17",
      "jql": "project = \"KAN\" AND labels = \"dependabot-alert-e6bebe4d0a17\"",
      "note": "The dedupe block every shipped config uses."
    },
